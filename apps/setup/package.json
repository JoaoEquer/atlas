{
  "name": "atlas-setup",
  "productName": "Atlas Setup",
  "private": true,
  "version": "1.0.0",
  "description": "A file to download and open that installs Atlas: it runs the installer it carries and shows each step.",
  "license": "MIT",
  "type": "module",
  "main": "out/main.cjs",
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "electron": "43.7.5",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "electron@43.7.5": true,
    "esbuild@0.28.1": true
  }
}
