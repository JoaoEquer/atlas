{
  "name": "atlas-desktop",
  "productName": "Atlas",
  "private": true,
  "version": "0.0.0",
  "description": "The Atlas desktop app: the conversations, on a local or remote Atlas server.",
  "license": "MIT",
  "type": "module",
  "main": "out/main.mjs",
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@nanostores/react": "1.1.0",
    "@tabler/icons-react": "3.44.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "11.17.2",
    "nanostores": "1.4.2",
    "radix-ui": "1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "streamdown": "2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "43.7.5",
    "esbuild": "0.28.1",
    "eslint": "10.11.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "electron@43.7.5": true,
    "esbuild@0.28.1": true
  }
}
