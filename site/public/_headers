# Built assets carry their hash in their name, so they never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600

# Who Atlas is to an MCP server's sign-in (step 24), read by authorization servers.
/oauth/client.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
