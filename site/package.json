{
  "name": "atlas-site",
  "private": true,
  "version": "0.0.0",
  "description": "The Atlas website: the home, the news, the changelog and the documentation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "typecheck": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "news:draft": "node scripts/news-draft.mjs",
    "installs": "node scripts/installs.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/starlight": "0.42.7",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261025.1",
    "@eslint/js": "9.39.5",
    "eslint": "10.11.0",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.11"
  }
}
