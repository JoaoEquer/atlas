---
import { REPOSITORY } from '../../site.config.mjs'
import Mark from '../assets/atlas-mark.svg'

import { type Lang, localized, WORDS } from '../lib/i18n'

interface Props {
  current?: 'home' | 'news' | 'changelog' | undefined
  lang?: Lang
  /** This page in the other language, when it has one. */
  switchTo?: string | undefined
}

const { current, lang = 'en', switchTo } = Astro.props
const words = WORDS[lang]
const links = [
  { href: localized('/docs/', lang), label: words.nav.docs },
  { href: '/news/', label: words.nav.news, key: 'news' },
  { href: '/changelog/', label: words.nav.changelog, key: 'changelog' },
  { href: REPOSITORY, label: 'GitHub' }
]
---

<header class="nav" data-nav>
  <a class="brand" href={localized('/', lang)} aria-label={words.home}>
    <Mark class="brand-mark" aria-hidden="true" />
    <span class="brand-name">Atlas</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span class="visually-hidden">{words.menu}</span>
    <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </button>
  <nav class="menu" id="site-menu" aria-label={words.mainNav} data-menu>
    <ul>
      {links.map(link => (
        <li>
          <a href={link.href} aria-current={link.key !== undefined && link.key === current ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      {switchTo && (
        <li>
          <a class="language" href={switchTo} hreflang={lang === 'en' ? 'pt-BR' : 'en'} title={words.switchTitle}>
            {words.switchLabel}
          </a>
        </li>
      )}
    </ul>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={words.theme}>
      <svg
        width="18"
        height="18"
        viewBox="0 0 20 20"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <circle cx="10" cy="10" r="4"></circle>
        <path
          d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <a class="button button--solid install" href={`${localized('/', lang)}#install`}>
      {words.footer.install}
    </a>
  </nav>
</header>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')
  themeToggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('starlight-theme', next)
    } catch {
      // The choice lasts for this visit only.
    }
  })
</script>

<script>
  // The bar gains a backdrop once the page has scrolled, and the menu opens on small screens.
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  if (nav && toggle) {
    const onScroll = () => {
      nav.toggleAttribute('data-scrolled', window.scrollY > 8)
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true'
      toggle.setAttribute('aria-expanded', String(open))
      nav.toggleAttribute('data-open', open)
    })
    nav.addEventListener('click', event => {
      if (event.target instanceof HTMLAnchorElement) {
        toggle.setAttribute('aria-expanded', 'false')
        nav.removeAttribute('data-open')
      }
    })
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--starlight);
    cursor: pointer;
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .theme-toggle:hover {
    border-color: var(--starlight);
  }

  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.25rem;
    padding: 0 var(--gutter);
    border-bottom: 1px solid transparent;
    transition:
      background 0.3s,
      border-color 0.3s,
      backdrop-filter 0.3s;
  }

  .nav[data-scrolled] {
    border-bottom-color: var(--rule);
    background: rgb(var(--bg-rgb) / 0.72);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--starlight);
    text-decoration: none;
  }

  .brand-mark {
    width: 1.6rem;
    height: 1.6rem;
  }

  .brand-name {
    font-size: 1.125rem;
    font-weight: 640;
    font-stretch: var(--wide);
    letter-spacing: -0.01em;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .menu ul {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu ul a {
    color: var(--haze);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .menu ul a:hover,
  .menu ul a[aria-current='page'] {
    color: var(--starlight);
  }

  .install {
    min-height: 2.25rem;
    padding: 0 1rem;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--rule-strong);
      border-radius: 0;
      background: transparent;
      color: var(--starlight);
      cursor: pointer;
    }

    .menu {
      position: fixed;
      inset: 4.25rem 0 auto;
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.25rem var(--gutter) 1.75rem;
      border-bottom: 1px solid var(--rule);
      background: rgb(var(--bg-rgb) / 0.96);
      backdrop-filter: blur(14px);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity 0.2s,
        transform 0.2s var(--ease-out),
        visibility 0.2s;
    }

    .nav[data-open] .menu {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .nav[data-open] {
      background: rgb(var(--bg-rgb) / 0.96);
    }

    .menu ul {
      flex-direction: column;
      gap: 0;
    }

    .menu ul a {
      display: block;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--rule);
      color: var(--starlight);
      font-size: var(--step-1);
      font-stretch: var(--wide);
    }

    .install {
      min-height: 3rem;
    }
  }
</style>
