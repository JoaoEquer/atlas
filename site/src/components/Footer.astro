---
import { REPOSITORY } from '../../site.config.mjs'
import Mark from '../assets/atlas-mark.svg'
import { type Lang, localized, WORDS } from '../lib/i18n'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const words = WORDS[lang].footer
const at = (path: string) => localized(path, lang)
const columns = [
  {
    title: words.atlas,
    links: [
      { href: `${at('/')}#install`, label: words.install },
      { href: at('/docs/'), label: words.documentation },
      { href: '/changelog/', label: WORDS[lang].nav.changelog },
      { href: '/news/', label: WORDS[lang].nav.news }
    ]
  },
  {
    title: words.guides,
    links: [
      { href: at('/docs/guides/coding-agents/'), label: words.codingAgents },
      { href: at('/docs/guides/machines/'), label: words.machines },
      { href: at('/docs/guides/models/'), label: words.models },
      { href: at('/docs/troubleshooting/'), label: words.troubleshooting }
    ]
  },
  {
    title: words.openSource,
    links: [
      { href: REPOSITORY, label: 'GitHub' },
      { href: `${REPOSITORY}/issues`, label: words.issues },
      { href: at('/docs/extending/plugins/'), label: words.writePlugin },
      { href: `${REPOSITORY}/blob/main/LICENSE`, label: words.license }
    ]
  },
  {
    title: words.forAgents,
    links: [
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/llms-full.txt', label: 'llms-full.txt' },
      { href: lang === 'en' ? '/index.md' : '/pt-br/index.md', label: words.markdown },
      { href: '/changelog/rss.xml', label: words.changelogFeed }
    ]
  }
]
---

<footer class="footer">
  <div class="page wordmark" data-wordmark="Atlas">
    <canvas aria-hidden="true"></canvas>
    <p class="visually-hidden">Atlas</p>
  </div>
  <div class="page footer-grid">
    <div class="footer-brand">
      <a class="footer-home" href={at('/')} aria-label={WORDS[lang].home}>
        <Mark class="footer-mark" aria-hidden="true" />
      </a>
      <p class="footer-line">{words.line}</p>
      <p>{words.blurb}</p>
      <a class="button button--solid footer-install" href={`${at('/')}#install`}>
        {words.installAtlas}
      </a>
    </div>
    <nav class="footer-links" aria-label={words.label}>
      {columns.map(column => (
        <div>
          <p class="footer-title">{column.title}</p>
          <ul>
            {column.links.map(link => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="page footer-base">
    <p>{words.affiliation}</p>
    <p>{words.fonts}</p>
  </div>
</footer>

<style>
  .wordmark {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .wordmark canvas {
    width: 100%;
    min-height: 6rem;
  }

  .footer {
    position: relative;
    padding: 5.5rem 0 2.5rem;
    border-top: 1px solid var(--rule);
    background: var(--night);
    color: var(--haze);
    font-size: var(--step--1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(3rem, 6vw, 6rem);
  }

  .footer-brand {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    max-width: 22rem;
  }

  .footer-home {
    color: var(--starlight);
  }

  .footer-mark {
    width: 2.75rem;
    height: 2.75rem;
  }

  .footer-line {
    color: var(--starlight);
    font-size: var(--step-1);
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .footer-install {
    margin-top: 0.5rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-title {
    margin-bottom: 1rem;
    color: var(--starlight);
    font-size: var(--step--2);
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-links ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--haze);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--starlight);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 4.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--2);
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
