---
// The rest of the site, beside the GitHub link. The news and the changelog are in English only.
import Default from '@astrojs/starlight/components/SocialIcons.astro'

import { WORDS } from '../../lib/i18n'

const words = WORDS[Astro.locals.starlightRoute.locale === 'pt-br' ? 'pt-br' : 'en'].nav
---

<a class="link" href="/news/">
  {words.news}
</a>
<a class="link" href="/changelog/">
  {words.changelog}
</a>
<Default />

<style>
  .link {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .link:hover {
    color: var(--sl-color-white);
  }
</style>
