---
// The frame of every page outside the documentation: the head with what search engines, feeds and
// agents read, the navigation, and the footer.
import '@fontsource-variable/mona-sans/wdth.css'
import '@fontsource-variable/martian-mono/wdth.css'
import '../styles/site.css'
import monaLatin from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url'

import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import { HTML_LANG, type Lang, OG_LOCALE, WORDS } from '../lib/i18n'
import { jsonLd, organization, website } from '../lib/seo'

interface Props {
  title: string
  description: string
  /** This page's Markdown twin, for agents, when it has one. */
  markdown?: string
  current?: 'home' | 'news' | 'changelog'
  /** The share image, from `public/`. */
  image?: string
  /** Structured data for search engines, beside the site's own. */
  schema?: Record<string, unknown>[] | undefined
  /** Kept out of search results, as the 404 is. */
  noindex?: boolean
  lang?: Lang
  /** The same page in each language it has, for search engines and the language switch. */
  alternates?: Partial<Record<Lang, string>>
}

const {
  title,
  description,
  markdown,
  current,
  image = '/og.jpg',
  schema = [],
  noindex = false,
  lang = 'en',
  alternates = {}
} = Astro.props
const words = WORDS[lang]
const other = lang === 'en' ? 'pt-br' : 'en'
const switchTo = alternates[other]
const site = Astro.site ?? new URL(Astro.url.origin)
const canonical = new URL(Astro.url.pathname, site)
const imageUrl = new URL(image, site)
const graph = jsonLd([organization(site), website(site), ...schema])
---

<!doctype html>
<html lang={HTML_LANG[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([code, path]) => (
      <link rel="alternate" hreflang={HTML_LANG[code as Lang]} href={new URL(path, site)} />
    ))}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, site)} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // The theme: what the visitor chose, on any page of the site and of the documentation, or
      // else what the system prefers. Set before the page paints, so it never flashes.
      try {
        const stored = localStorage.getItem('starlight-theme')
        const light = stored ? stored === 'light' : matchMedia('(prefers-color-scheme: light)').matches
        document.documentElement.dataset.theme = light ? 'light' : 'dark'
      } catch {
        document.documentElement.dataset.theme = 'dark'
      }
    </script>
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="application/rss+xml" title="Atlas news" href="/news/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Atlas changelog" href="/changelog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atlas" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={words.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" is:inline set:html={graph} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {words.skip}
    </a>
    <Nav current={current} lang={lang} switchTo={switchTo} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/ascii-field'
      import '../scripts/scramble'
      import '../scripts/chrome'
    </script>
  </body>
</html>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
