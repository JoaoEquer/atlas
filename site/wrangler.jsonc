// The site on Cloudflare Workers: the built files in dist, and worker/index.ts in front of the pages
// for agents (Markdown on request, Link headers). Built files that are not pages skip the Worker.
// Each download of an installer is written to Analytics Engine (worker/installs.ts), and each visit
// to the home with what it does next (worker/home.ts).
{
  "name": "atlas-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-25",
  "routes": [{ "pattern": "atlasv4.com", "custom_domain": true }],
  "analytics_engine_datasets": [
    { "binding": "INSTALLS", "dataset": "atlas_installs" },
    { "binding": "HOME", "dataset": "atlas_home" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/pagefind/*", "!/favicon.svg", "!/og.jpg"]
  }
}
